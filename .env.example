# Copy to .env (gitignored) and fill in. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLAMA_CLOUD_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=

# Per-role model selectors: <provider>:<model>. Providers: anthropic, openai, gemini, groq, openrouter
LLM_DEFAULT=anthropic:claude-opus-4-5-20251101
LLM_RAG=gemini:gemini-2.5-flash
LLM_ANALYSIS=groq:qwen/qwen3.8-27b
LLM_STRATEGY=groq:qwen/qwen3.8-27b
LLM_RESEARCH=anthropic:claude-opus-4-5-20251101
LLM_COMPARE=anthropic:claude-opus-4-5-20251101

# Free tier (operator keys): JSON list of "<provider>:<model>" users may pick without their own key.
FREE_MODELS=["groq:qwen/qwen3.8-27b","gemini:gemini-2.5-flash"]
COMPLEX_TASKS_REQUIRE_BYOK=true
FREE_RATE_LIMIT_PER_HOUR=20
BYOK_RATE_LIMIT_PER_HOUR=200
SESSION_TTL_MINUTES=120
MAX_UPLOAD_MB=25
MAX_PAGES=300
MAX_DOCS_PER_SESSION=5
# Set true only behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY_HEADERS=false
